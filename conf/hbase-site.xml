<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!--
  Shared by every container that talks to HBase. It is mounted at
  /opt/hbase/conf/hbase-site.xml in the hbase, hbase-init and flume services.
  The server reads all of it; the clients only care about the ZooKeeper entries.
-->
<configuration>
  <!-- Where clients find ZooKeeper. "hbase" is the compose service/hostname. -->
  <property>
    <name>hbase.zookeeper.quorum</name>
    <value>hbase</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.clientPort</name>
    <value>2181</value>
  </property>

  <!-- Embedded ZooKeeper must listen on the container IP, not just loopback,
       or the Flume container cannot reach it. -->
  <property>
    <name>hbase.zookeeper.property.clientPortAddress</name>
    <value>0.0.0.0</value>
  </property>

  <!-- Standalone mode: one JVM, local filesystem, embedded ZooKeeper. -->
  <property>
    <name>hbase.cluster.distributed</name>
    <value>false</value>
  </property>
  <property>
    <name>hbase.rootdir</name>
    <value>file:///data/hbase</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.dataDir</name>
    <value>/data/zookeeper</value>
  </property>

  <!-- The local filesystem cannot hflush/hsync; tell HBase that is fine. -->
  <property>
    <name>hbase.unsafe.stream.capability.enforce</name>
    <value>false</value>
  </property>
</configuration>
